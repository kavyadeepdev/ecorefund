# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter API Key for Digital Twin waste image classification
VITE_OPENAI_API_KEY="YOUR_API_KEY_HERE"

# OpenRouter API Base URL
VITE_OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# LLM Model identifier (Currently using Nvidia Nemotron Nano Vision-Language)
VITE_OPENAI_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"


